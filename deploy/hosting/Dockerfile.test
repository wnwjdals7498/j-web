FROM node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    nginx=1.22.1-9+deb12u10 openssh-server=1:9.2p1-2+deb12u10 \
    vsftpd=3.0.3-13+b2 sudo=1.9.13p3-1+deb12u4 sshpass=1.09-1+b1 \
    python3=3.11.2-1+b1 openssl=3.0.22-1~deb12u1 procps=2:4.0.2-3 \
    && rm -rf /var/lib/apt/lists/* && ln -s /usr/local/bin/node /usr/bin/node \
    && groupadd --gid 1700 jweb-sftp && useradd --uid 1701 --no-create-home --shell /usr/sbin/nologin jweb \
    && mkdir -p /srv/jweb /var/lib/jweb /var/lib/jweb-ftps/empty /etc/nginx/jweb.d /etc/jweb/tls /run/sshd \
    && rm -f /etc/nginx/sites-enabled/default
# Read-only BuildKit inputs keep file installation in one layer. The cloud's
# VFS driver otherwise copies the whole filesystem for each small COPY step.
RUN --mount=type=bind,source=deploy,target=/opt/jweb-build/deploy,readonly \
    --mount=type=bind,source=tests/hosting,target=/opt/jweb-build/hosting,readonly \
    --mount=type=bind,source=apps/server/dist,target=/opt/jweb-build/server,readonly \
    install -m 0555 /opt/jweb-build/deploy/jweb-helper.mjs /usr/local/sbin/jweb-helper \
    && install -m 0440 /opt/jweb-build/deploy/hosting/jweb.sudoers /etc/sudoers.d/jweb \
    && install -m 0600 /opt/jweb-build/deploy/hosting/sshd_config /etc/jweb/sshd_config \
    && install -m 0600 /opt/jweb-build/deploy/hosting/vsftpd.conf /etc/jweb/vsftpd.conf \
    && install -d -m 0755 /opt/jweb-fixture/server \
    && install -m 0644 /opt/jweb-build/hosting/entrypoint.mjs /opt/jweb-fixture/entrypoint.mjs \
    && install -m 0644 /opt/jweb-build/hosting/protocols.py /opt/jweb-fixture/protocols.py \
    && cp -R /opt/jweb-build/server/. /opt/jweb-fixture/server/ \
    && chmod -R a+rX /opt/jweb-fixture/server \
    && visudo -cf /etc/sudoers.d/jweb
ENTRYPOINT ["node", "/opt/jweb-fixture/entrypoint.mjs"]
